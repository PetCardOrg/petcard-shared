{
  "name": "@petcardorg/shared",
  "version": "0.18.0",
  "description": "DTOs, enums e types compartilhados do ecossistema PetCard",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": "eslint --fix",
    "*.{ts,json,md}": "prettier --write"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PetCardOrg/petcard-shared.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/swagger": "^11.4.5",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.20.0"
  },
  "peerDependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  }
}
